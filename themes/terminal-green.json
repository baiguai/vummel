{
  "name": "Terminal Green",
  "description": "Classic terminal theme with green phosphor display",
  "styles": {
    "body": {
      "background": "#000000",
      "color": "#00ff00",
      "fontFamily": "Courier New, monospace"
    },
    "canvas": {
      "background": "#000000"
    },
    "node": {
      "background": "#0a0a0a",
      "color": "#00ff00",
      "border": "1px solid #00ff00"
    },
    "nodeHeader": {
      "color": "#00ff00",
      "background": "#0a0a0a"
    },
    "nodeContent": {
      "background": "#000000",
      "color": "#00ff00",
      "border": "none",
      "fontFamily": "Courier New, monospace"
    },
    "dropzone": {
      "background": "#050505",
      "color": "#00ff00",
      "border": "1px dashed #00ff00"
    },
    "dialog": {
      "background": "#0a0a0a",
      "color": "#00ff00",
      "border": "2px solid #00ff00"
    },
    "button": {
      "background": "#0a0a0a",
      "color": "#00ff00",
      "border": "1px solid #00ff00"
    },
    "connector": {
      "stroke": "#00ff00",
      "strokeWidth": "1"
    }
  }
}