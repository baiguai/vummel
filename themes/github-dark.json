{
  "name": "GitHub Dark",
  "description": "Inspired by GitHub's dark theme",
  "styles": {
    "body": {
      "background": "#0d1117",
      "color": "#c9d1d9"
    },
    "canvas": {
      "background": "#0d1117"
    },
    "node": {
      "background": "#161b22",
      "color": "#c9d1d9",
      "border": "1px solid #30363d"
    },
    "nodeHeader": {
      "color": "#f0f6fc",
      "background": "#21262d"
    },
    "nodeContent": {
      "background": "#0d1117",
      "color": "#c9d1d9",
      "border": "1px solid #30363d"
    },
    "dropzone": {
      "background": "#161b22",
      "color": "#c9d1d9",
      "border": "1px dashed #30363d"
    },
    "dialog": {
      "background": "#21262d",
      "color": "#c9d1d9",
      "border": "2px solid #30363d"
    },
    "button": {
      "background": "#238636",
      "color": "#ffffff",
      "border": "1px solid #2ea043"
    },
    "connector": {
      "stroke": "#58a6ff",
      "strokeWidth": "2"
    }
  }
}